#!/usr/bin/env python3
"""Offline notes-stage CLI: reject slash dispatch before accepting a task."""
import json
import os
import sys

argv = sys.argv[1:]
prompt = argv[argv.index('-z') + 1]
with open(os.path.join(os.environ['FAKE_STATE_DIR'], 'hermes.jsonl'), 'a') as stream:
    stream.write(json.dumps({'argv': argv, 'cwd': os.getcwd()}) + '\n')
if prompt.lstrip().startswith('/'):
    print('Unknown command: ' + prompt.split()[0], file=sys.stderr)
    sys.exit(2)
print('Offline task accepted; no state changes performed.')
