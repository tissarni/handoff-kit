#!/usr/bin/env bash
# handoff git hook. handoff-launch.sh points core.hooksPath at a copy of this directory for
# every repo stage it launches, so commits made by an agent carry two trailers —
# `Harness: <claude-code|hermes|devin>` and `Model: <resolved model>` — and never a
# Co-Authored-By line. A manual shell has no HANDOFF_HARNESS, so here it only chains.
set -eu
MSG="$1"
if [ -n "${HANDOFF_HARNESS:-}" ]; then
  # Agents copy attribution from git history; strip whatever came along.
  sed -i -E '/^[[:space:]]*Co-Authored-By:/Id; /Generated with \[Claude Code\]/d' "$MSG"
  # `git merge` writes MERGE_MSG with no final newline; interpret-trailers would then glue
  # the trailers onto the subject paragraph, where no parser (commit-msg's included) sees them.
  [ -s "$MSG" ] && [ -n "$(tail -c1 "$MSG")" ] && printf '\n' >>"$MSG"
  # `replace`: the launcher knows the real values; an agent's own guess does not win.
  git interpret-trailers --in-place --if-exists replace \
    --trailer "Harness: $HANDOFF_HARNESS" \
    --trailer "Model: ${HANDOFF_MODEL:-unknown}" "$MSG"
fi
# The override hides the repo's own hook; hand over to it.
OWN="$(git rev-parse --git-common-dir)/hooks/$(basename "$0")"
[ -x "$OWN" ] && exec "$OWN" "$@"
exit 0
